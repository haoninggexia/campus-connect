<template name="chat-page-status">
    <view style="background-color: {{chatStatue==='open'?'#00ffff':'#ff0088'}};box-shadow: {{chatStatue==='open'?'0 0 20rpx rgba(0,255,255,0.5)':'0 0 20rpx rgba(255,0,136,0.5)'}};" class="chat-page-status-style">
        {{chatStatusContent}}
    </view>
</template>
