
.btn-voice-press {
    background-color: rgba(0, 255, 255, 0.35);
}

button{
    font-size: 32rpx;
    width:100%;
    line-height: 74rpx;
    margin-top: 15rpx;
    margin-bottom: 15rpx;
    color: #f0f0ff;
}
.voice-status-style{
    position: absolute;
    left: 0;
    bottom: 22rpx;
    width: 80%;
    text-align: center;
    font-size: 24rpx;
    color: #ffea00;
    padding-top: 5rpx;
    padding-bottom: 5rpx;
    margin-left: 10%;
    border-radius: 10rpx;
    background: rgba(0, 255, 255, 0.2);
    text-shadow:
      0 0 10rpx rgba(255, 234, 0, 0.6),
      0 0 20rpx rgba(255, 234, 0, 0.3);
    border: 2rpx solid rgba(0, 255, 255, 0.3);
    box-shadow: 0 0 20rpx rgba(0, 255, 255, 0.15);
}

.voice-record-git-status-style{
    position: absolute;
    left: 0;
    bottom: 75rpx;
    width: 100%;
    display: flex;
    justify-content: center;
}

.voice-record-git-size-style{
    width: 58rpx;
    height: 10rpx;
}
