.press-style{
    background-color: rgba(0, 255, 255, 0.3);
}

.press-style-opacity{
    opacity: 0.5;
}

.extra-super{
    display: flex;
    padding-top: 25rpx;
    height: 234rpx;
    width: 100%;
    background: rgba(10, 10, 30, 0.95);
    border-top: 2rpx solid rgba(0, 255, 255, 0.2);
    box-shadow: 0 -4rpx 20rpx rgba(0, 255, 255, 0.08);
}
.extra-image-size{
    width: 114rpx;
    height: 114rpx
}
.extra-text-size{
    color: #00ffcc;
    font-size: 24rpx;
    margin-top: 10rpx;
    text-shadow: 0 0 10rpx rgba(0, 255, 204, 0.4);
}

.flex-column {
    display: flex;
    flex-direction: column;
    align-items: center;
}
.flex-row{
    display: flex;
}
