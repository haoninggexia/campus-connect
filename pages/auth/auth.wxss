.auth-container {
  padding: 60rpx 40rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.header {
  text-align: center;
  margin-bottom: 100rpx;
  padding-top: 100rpx;
}

.logo {
  width: 200rpx;
  height: 200rpx;
  border-radius: 40rpx;
  background: white;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}

.title {
  display: block;
  font-size: 80rpx;
  font-weight: bold;
  color: white;
  margin: 40rpx 0 20rpx;
  letter-spacing: 4rpx;
}

.subtitle {
  font-size: 44rpx;
  color: rgba(255, 255, 255, 0.8);
}

.form {
  background: white;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
}

.picker, .input {
  background: #f5f7fa;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 46rpx;
  color: #333;
  min-height: 90rpx;
}

.placeholder {
  color: #999;
}

.placeholder-text {
  color: #999;
}

.arrow {
  color: #999;
  font-size: 40rpx;
}

.btn-login {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 16rpx;
  margin-top: 50rpx;
  font-size: 48rpx;
  font-weight: bold;
  border: none;
}

.btn-login::after {
  border: none;
}

.tips {
  text-align: center;
  margin-top: 40rpx;
  font-size: 36rpx;
  color: #999;
}

.tips .link {
  color: #667eea;
  margin: 0 8rpx;
}
