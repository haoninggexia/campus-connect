<view class="auth-container">
  <view class="header">
    <image src="/image/my_head.jpeg" class="logo" mode="aspectFit"></image>
    <text class="title">校有磁力</text>
    <text class="subtitle">山东中医药大学（槐荫校区）</text>
  </view>

  <view class="form">
    <button
      class="btn-login"
      open-type="getUserInfo"
      bindgetuserinfo="onLogin"
    >
      微信授权登录
    </button>

    <view class="tips">
      <text>登录即表示同意</text>
      <text class="link">用户协议</text>
      <text>和</text>
      <text class="link">隐私政策</text>
    </view>
  </view>
</view>
