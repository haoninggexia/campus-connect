<import src="view/chat-item.wxml"/>

<!-- 顶部用户信息栏 -->
<view class="header-user-info" bindtap="onToMyProfile">
  <image class="my-avatar" src="{{myAvatar}}" mode="aspectFill"></image>
  <view class="my-info">
    <text class="my-name">{{myNickName}}</text>
    <text class="my-id">ID: {{myUserID}}</text>
  </view>
  <view class="my-actions">
    <text class="arrow">›</text>
  </view>
</view>

<!-- 在线聊天室区域 -->
<view class="online-chat-section">
  <!-- 大学选择 -->
  <view class="university-selector">
    <scroll-view scroll-x class="uni-scroll">
      <view class="uni-item {{currentUniversity === uni ? 'active' : ''}}" 
            wx:for="{{universities}}" 
            wx:key="*this"
            data-university="{{uni}}"
            bindtap="onSwitchUniversity">
        {{uni}}
      </view>
    </scroll-view>
  </view>

  <!-- 创建房间按钮 -->
  <view class="create-room-section">
    <button class="create-btn" bindtap="onCreateRoom" type="primary">
      + 创建新聊天室
    </button>
    <view class="tip-text">创建新房间后，等待其他人加入即可开始聊天</view>
  </view>

  <!-- 房间列表 -->
  <view class="rooms-section">
    <text class="refresh-tip" wx:if="{{loading}}" style="display:block;text-align:center;padding:10rpx 0;">刷新中...</text>
    <view class="rooms-list">
      <view class="room-item" wx:for="{{rooms}}" wx:key="_id" bindtap="onEnterRoom" data-roomid="{{item._id}}">
        <view class="room-header">
          <text class="room-name">聊天室 #{{index + 1}}</text>
          <text class="room-status" style="color: {{item.status === 0 ? '#999' : (item.status === 1 ? '#07c160' : '#ff5252')}}">
            {{item.status === 0 ? '空闲' : (item.status === 1 ? '等待中 (1/2)' : '聊天中 (2/2)')}}
          </text>
        </view>
        
        <view class="room-info">
          <view class="user-info" wx:if="{{item.user1}}">
            <image class="user-avatar" src="{{item.user1.avatarUrl}}" mode="aspectFill"></image>
            <text class="user-name">{{item.user1.nickName}}</text>
          </view>
          
          <view class="user-info" wx:if="{{item.user2}}">
            <image class="user-avatar" src="{{item.user2.avatarUrl}}" mode="aspectFill"></image>
            <text class="user-name">{{item.user2.nickName}}</text>
          </view>
          
          <view class="empty-tip" wx:if="{{!item.user1 && !item.user2}}">
            空闲中，等待加入...
          </view>
        </view>
        
        <view class="room-time">
          创建时间：{{item.createTime}}
        </view>
      </view>
      
      <view class="empty-tip" wx:if="{{rooms.length === 0 && !loading}}">
        暂无聊天室，点击上方按钮创建一个吧
      </view>
    </view>
  </view>
</view>

