/* pages/chat-list/chat-list.wxss - Cyberpunk MAX Theme */

/* 顶部用户信息栏 */
.header-user-info {
  background: linear-gradient(180deg, rgba(10, 10, 35, 0.98) 0%, rgba(10, 10, 30, 0.95) 100%);
  padding: 12px 15px;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 20rpx rgba(0, 255, 255, 0.12), 0 0 30rpx rgba(255, 0, 255, 0.08);
  border-bottom: 2rpx solid rgba(0, 255, 255, 0.15);
  position: sticky;
  top: 0;
  z-index: 10;
  backdrop-filter: blur(30rpx);
}

.my-avatar {
  width: 50px;
  height: 50px;
  border-radius: 12px;
  border: 2px solid #00ffff;
  box-shadow:
    0 0 20rpx rgba(0, 255, 255, 0.6),
    0 0 40rpx rgba(0, 255, 255, 0.3),
    0 0 60rpx rgba(255, 0, 255, 0.2);
  margin-right: 12px;
}

.my-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.my-name {
  font-size: 16px;
  font-weight: 700;
  color: #f0f0ff;
  margin-bottom: 2px;
  text-shadow: 0 0 10rpx rgba(0, 255, 255, 0.3);
}

.my-id {
  font-size: 12px;
  color: #00ffcc;
  text-shadow: 0 0 8rpx rgba(0, 255, 204, 0.3);
}

.my-actions {
  padding-left: 10px;
}

.arrow {
  font-size: 20px;
  color: #ff6bff;
  font-weight: 300;
  text-shadow: 0 0 10rpx rgba(255, 107, 255, 0.5);
}

/* 在线聊天室区域 */
.online-chat-section {
  background: linear-gradient(180deg, #020010 0%, #080025 100%);
}

/* 实时在线人数 */
.online-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 20rpx 0;
  padding: 16rpx 30rpx;
  background: rgba(10, 10, 30, 0.9);
  border-radius: 40rpx;
  border: 2rpx solid rgba(0, 255, 255, 0.3);
  box-shadow:
    0 0 30rpx rgba(0, 255, 255, 0.15),
    inset 0 0 20rpx rgba(0, 255, 255, 0.05);
}

.online-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #00ff88;
  margin-right: 16rpx;
  box-shadow:
    0 0 12rpx rgba(0, 255, 136, 0.8),
    0 0 24rpx rgba(0, 255, 136, 0.4);
  animation: onlinePulse 1.5s ease-in-out infinite;
}

@keyframes onlinePulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.85); }
}

.online-label {
  font-size: 26rpx;
  color: #aaa0d0;
  margin-right: 12rpx;
}

.online-count {
  font-size: 34rpx;
  font-weight: 900;
  color: #00ffff;
  text-shadow: 0 0 20rpx rgba(0, 255, 255, 0.8);
  margin-right: 8rpx;
}

.online-unit {
  font-size: 24rpx;
  color: #7a80b0;
}

/* 大学选择器 */
.university-selector {
  background: rgba(10, 10, 30, 0.9);
  padding: 20rpx 0;
  border-bottom: 2rpx solid rgba(0, 255, 255, 0.15);
  box-shadow: 0 4rpx 20rpx rgba(0, 255, 255, 0.06);
}

.uni-scroll {
  white-space: nowrap;
  padding: 0 20rpx;
}

.uni-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 20rpx;
  background: rgba(20, 20, 50, 0.7);
  border: 2rpx solid rgba(0, 255, 255, 0.2);
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #aaa0d0;
  transition: all 0.3s;
  box-shadow: 0 0 10rpx rgba(0, 255, 255, 0.05);
}

.uni-item.active {
  background: linear-gradient(135deg, rgba(0, 255, 255, 0.35) 0%, rgba(123, 47, 255, 0.4) 100%);
  border-color: #00ffff;
  color: #00ffff;
  box-shadow:
    0 0 30rpx rgba(0, 255, 255, 0.6),
    0 0 50rpx rgba(123, 47, 255, 0.4);
  text-shadow: 0 0 15rpx rgba(0, 255, 255, 0.8);
}

/* 创建房间区域 */
.create-room-section {
  background: rgba(10, 10, 30, 0.85);
  margin: 0 20rpx 20rpx;
  padding: 24rpx 30rpx;
  border-radius: 20rpx;
  border: 2rpx solid rgba(0, 255, 255, 0.25);
  box-shadow:
    0 0 30rpx rgba(0, 255, 255, 0.15),
    0 0 60rpx rgba(255, 0, 255, 0.08),
    inset 0 0 20rpx rgba(0, 255, 255, 0.03);
}

.create-btn {
  background: linear-gradient(135deg, #00ffcc 0%, #00ffff 30%, #7b2fff 60%, #ff00ff 100%);
  color: #020010;
  border: none;
  border-radius: 50rpx;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
  box-shadow:
    0 0 40rpx rgba(0, 255, 255, 0.7),
    0 0 80rpx rgba(123, 47, 255, 0.5),
    0 0 120rpx rgba(255, 0, 255, 0.3);
}

.create-btn:active {
  box-shadow:
    0 0 60rpx rgba(0, 255, 255, 1),
    0 0 120rpx rgba(123, 47, 255, 0.8),
    0 0 180rpx rgba(255, 0, 255, 0.5);
}

.tip-text {
  text-align: center;
  font-size: 24rpx;
  color: #7a80b0;
  margin-top: 8rpx;
}

/* 房间列表 */
.rooms-section {
  margin: 0 20rpx 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  background: linear-gradient(90deg, #00ffff 0%, #ff6bff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
  letter-spacing: 4rpx;
}

.refresh-tip {
  font-size: 24rpx;
  color: #ffea00;
  margin-left: 20rpx;
  text-shadow: 0 0 15rpx rgba(255, 234, 0, 0.6);
}

.rooms-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.room-item {
  background: rgba(10, 10, 30, 0.85);
  border-radius: 20rpx;
  padding: 30rpx;
  border: 2rpx solid rgba(0, 255, 255, 0.2);
  box-shadow:
    0 0 20rpx rgba(0, 255, 255, 0.1),
    inset 0 0 15rpx rgba(0, 255, 255, 0.02);
  transition: all 0.3s;
}

/* 男性房间 - 青色边框 */
.room-item-male {
  border-color: rgba(0, 255, 255, 0.7);
  background: linear-gradient(135deg, rgba(0, 255, 255, 0.1) 0%, rgba(10, 10, 30, 0.85) 100%);
  box-shadow:
    0 0 35rpx rgba(0, 255, 255, 0.35),
    0 0 70rpx rgba(0, 255, 255, 0.15);
}

/* 女性房间 - 品红边框 */
.room-item-female {
  border-color: rgba(255, 0, 255, 0.7);
  background: linear-gradient(135deg, rgba(255, 0, 255, 0.1) 0%, rgba(10, 10, 30, 0.85) 100%);
  box-shadow:
    0 0 35rpx rgba(255, 0, 255, 0.35),
    0 0 70rpx rgba(255, 0, 255, 0.15);
}

.room-item:active {
  transform: scale(0.98);
  opacity: 0.95;
  box-shadow:
    0 0 50rpx rgba(0, 255, 255, 0.5),
    0 0 100rpx rgba(255, 0, 255, 0.3);
}

.room-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.room-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #f0f0ff;
  text-shadow: 0 0 10rpx rgba(0, 255, 255, 0.3);
}

.room-status {
  font-size: 24rpx;
  font-weight: bold;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  background: rgba(0, 255, 136, 0.2);
  color: #00ff88;
  border: 2rpx solid rgba(0, 255, 136, 0.5);
  text-shadow: 0 0 15rpx rgba(0, 255, 136, 0.6);
  box-shadow: 0 0 20rpx rgba(0, 255, 136, 0.3);
}

.room-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.user-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(20, 20, 50, 0.7);
  border: 2rpx solid rgba(0, 255, 255, 0.3);
  box-shadow: 0 0 15rpx rgba(0, 255, 255, 0.2);
}

.user-name {
  font-size: 28rpx;
  color: #ccc0f0;
}

.empty-tip {
  font-size: 26rpx;
  color: #7a80b0;
  text-align: center;
  padding: 20rpx 0;
}

.room-time {
  font-size: 22rpx;
  color: #7a80b0;
  border-top: 2rpx solid rgba(0, 255, 255, 0.12);
  padding-top: 20rpx;
}

/* 分隔线 */
.divider {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  background: transparent;
}

.divider text {
  font-size: 24rpx;
  color: #00ffcc;
  padding: 0 20rpx;
  position: relative;
  text-shadow: 0 0 10rpx rgba(0, 255, 204, 0.5);
}

.divider::before,
.divider::after {
  content: '';
  flex: 1;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(0, 255, 255, 0.4), transparent);
}

.divider::before {
  margin-right: 20rpx;
}

.divider::after {
  margin-left: 20rpx;
}

/* 性别标签 */
.gender-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-left: 10rpx;
}

.gender-male {
  color: #00ffff;
  background: rgba(0, 255, 255, 0.15);
  border: 2rpx solid rgba(0, 255, 255, 0.5);
  text-shadow: 0 0 12rpx rgba(0, 255, 255, 0.6);
  box-shadow: 0 0 15rpx rgba(0, 255, 255, 0.2);
}

.gender-female {
  color: #ff6bff;
  background: rgba(255, 107, 255, 0.15);
  border: 2rpx solid rgba(255, 107, 255, 0.5);
  text-shadow: 0 0 12rpx rgba(255, 107, 255, 0.6);
  box-shadow: 0 0 15rpx rgba(255, 107, 255, 0.2);
}

@import "view/chat-item.wxss";
