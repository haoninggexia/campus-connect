/* pages/chat-list/chat-list.wxss */

/* 顶部用户信息栏 */
.header-user-info {
  background-color: #fff;
  padding: 12px 15px;
  display: flex;
  align-items: center;
  box-shadow: 0 1px 2px rgba(0,0,0,0.08);
  position: sticky;
  top: 0;
  z-index: 10;
}

.my-avatar {
  width: 50px;
  height: 50px;
  border-radius: 25px;
  border: 2px solid #07c160;
  margin-right: 12px;
}

.my-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.my-name {
  font-size: 16px;
  font-weight: 500;
  color: #333;
  margin-bottom: 2px;
}

.my-id {
  font-size: 12px;
  color: #999;
}

.my-actions {
  padding-left: 10px;
}

.arrow {
  font-size: 20px;
  color: #ccc;
  font-weight: 300;
}

@import "view/chat-item.wxss";
