<!--pages/friends-tim/friends-tim.wxml-->
<view class="container">
  <!-- 顶部操作栏 -->
  <view class="header">
    <view class="search-box">
      <input
        class="search-input"
        placeholder="输入用户ID或昵称搜索..."
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearch"
      />
      <text wx:if="{{searchKeyword}}" class="search-clear" bindtap="onClearSearch">✕</text>
      <button class="search-button" bindtap="onSearch" size="mini">搜索</button>
    </view>
  </view>

  <!-- Tab切换 -->
  <view class="tabs">
    <view class="tab-item {{currentTab === 0 ? 'active' : ''}}" bindtap="switchTab" data-index="0">
      我的好友
    </view>
    <view class="tab-item {{currentTab === 1 ? 'active' : ''}}" bindtap="switchTab" data-index="1">
      所有用户
    </view>
  </view>

  <!-- 好友列表 -->
  <view class="friend-list" wx:if="{{currentTab === 0}}">
    <view wx:if="{{friends.length === 0}}" class="empty-state">
      <text class="empty-icon">👥</text>
      <text class="empty-text">暂无好友</text>
      <text class="empty-tip">去"所有用户"中添加好友吧</text>
    </view>

    <view
      class="friend-item"
      wx:for="{{friends}}"
      wx:key="userID"
      bindtap="onFriendClick"
      data-friend="{{item}}">
      <image class="friend-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
      <view class="friend-info">
        <view class="friend-name">{{item.nick}}</view>
        <view class="friend-status">
          <text class="status-dot {{item.online ? 'online' : 'offline'}}"></text>
          <text class="status-text">{{item.online ? '在线' : '离线'}}</text>
        </view>
      </view>
      <view class="friend-actions">
        <button class="action-button chat" size="mini" bindtap="onChat" data-friend="{{item}}" catchtap="true">
          💬 聊天
        </button>
        <button class="action-button delete" size="mini" bindtap="onDeleteFriend" data-friend="{{item}}" catchtap="true">
          删除
        </button>
      </view>
    </view>
  </view>

  <!-- 所有用户列表 -->
  <view class="friend-list" wx:if="{{currentTab === 1}}">
    <view wx:if="{{allUsers.length === 0 && !loading}}" class="empty-state">
      <text class="empty-icon">{{searchKeyword ? '🔍' : '👤'}}</text>
      <text class="empty-text">{{searchKeyword ? '未找到匹配的用户' : '暂无用户'}}</text>
      <text wx:if="{{searchKeyword}}" class="empty-tip">请检查用户ID或昵称是否正确</text>
      <text wx:else class="empty-tip">邀请朋友一起来使用吧</text>
    </view>

    <view wx:if="{{loading}}" class="loading">
      <text>加载中...</text>
    </view>

    <view
      class="friend-item"
      wx:for="{{allUsers}}"
      wx:key="userID"
      bindtap="onUserClick"
      data-user="{{item}}">
      <image class="friend-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
      <view class="friend-info">
        <view class="friend-name">{{item.nickName}}</view>
        <view class="friend-detail">{{item.university}} · {{item.major}}</view>
      </view>
      <view class="friend-actions">
        <button
          class="action-button {{item.isFriend ? 'added' : 'add'}}"
          size="mini"
          bindtap="onAddFriend"
          data-user="{{item}}"
          catchtap="true">
          {{item.isFriend ? '已添加' : '添加好友'}}
        </button>
      </view>
    </view>
  </view>
</view>
