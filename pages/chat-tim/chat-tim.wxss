/* pages/chat-tim/chat-tim.wxss - Cyberpunk MAX */
.container {
  width: 100%;
  align-items: stretch;
  justify-content: flex-start;
  padding: 0;
  box-sizing: border-box;
  background: linear-gradient(180deg, #020010 0%, #0a0020 100%);
}

/* 聊天标题栏 */
.chat-header {
  height: 44px;
  background: linear-gradient(180deg, rgba(10, 10, 35, 0.98) 0%, rgba(10, 10, 30, 0.95) 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 15px;
  box-shadow:
    0 4rpx 30rpx rgba(0, 255, 255, 0.15),
    0 0 60rpx rgba(255, 0, 255, 0.08);
  border-bottom: 2rpx solid rgba(0, 255, 255, 0.2);
  position: relative;
  z-index: 100;
  backdrop-filter: blur(30rpx);
}

.header-left,
.header-right {
  width: 44px;
  display: flex;
  align-items: center;
}

.iconfont {
  font-size: 24px;
  color: #ff6bff;
  text-shadow: 0 0 15rpx rgba(255, 107, 255, 0.6);
}

.header-title {
  flex: 1;
  text-align: center;
  font-size: 17px;
  font-weight: 700;
  color: #f0f0ff;
  letter-spacing: 4rpx;
  text-shadow: 0 0 15rpx rgba(0, 255, 255, 0.4);
}

/* 消息列表 */
.message-list {
  flex: 1;
  width: 100%;
  box-sizing: border-box;
  padding: 15px;
  overflow-y: auto;
}

.message-item {
  display: flex;
  margin-bottom: 20px;
  align-items: flex-start;
}

.message-item.self {
  flex-direction: row-reverse;
}

.message-item.other {
  flex-direction: row;
}

.avatar {
  width: 45px;
  height: 45px;
  border-radius: 8px;
  flex-shrink: 0;
  border: 2rpx solid rgba(0, 255, 255, 0.4);
  box-shadow:
    0 0 15rpx rgba(0, 255, 255, 0.25),
    0 0 30rpx rgba(0, 255, 255, 0.1);
}

.message-content {
  max-width: 70%;
  padding: 10px 15px;
  border-radius: 8px;
  position: relative;
}

.message-item.self .message-content {
  background: linear-gradient(135deg, rgba(0, 255, 136, 0.35) 0%, rgba(0, 255, 255, 0.3) 100%);
  margin-right: 10px;
  margin-left: 0;
  border: 2rpx solid rgba(0, 255, 136, 0.5);
  box-shadow:
    0 0 20rpx rgba(0, 255, 136, 0.35),
    0 0 40rpx rgba(0, 255, 255, 0.15);
}

.message-item.other .message-content {
  background: rgba(20, 20, 50, 0.85);
  margin-left: 10px;
  margin-right: 0;
  border: 2rpx solid rgba(255, 0, 255, 0.3);
  box-shadow:
    0 0 15rpx rgba(255, 0, 255, 0.15);
}

.friend-name {
  display: block;
  font-size: 12px;
  color: #ff6bff;
  margin-bottom: 5px;
  text-shadow: 0 0 10rpx rgba(255, 107, 255, 0.4);
}

.message-text {
  display: block;
  font-size: 15px;
  line-height: 1.5;
  color: #f0f0ff;
  word-break: break-all;
}

.message-time {
  display: block;
  font-size: 11px;
  color: #7a80b0;
  margin-top: 5px;
  text-align: right;
}

.message-item.other .message-time {
  text-align: left;
}

/* 输入框区域 */
.input-area {
  width: 100%;
  box-sizing: border-box;
  flex-shrink: 0;
  background: linear-gradient(180deg, rgba(10, 10, 35, 0.98) 0%, rgba(10, 10, 30, 0.95) 100%);
  border-top: 2rpx solid rgba(0, 255, 255, 0.2);
  padding: 10px;
  backdrop-filter: blur(30rpx);
  box-shadow: 0 -4rpx 30rpx rgba(0, 255, 255, 0.1);
}

.input-box {
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  background: rgba(0, 0, 20, 0.9);
  border: 2rpx solid rgba(0, 255, 255, 0.3);
  border-radius: 8px;
  padding: 8px 10px;
  box-shadow: inset 0 0 15rpx rgba(0, 255, 255, 0.08);
}

.message-input {
  flex: 1;
  min-width: 0;
  font-size: 15px;
  height: 40px;
  line-height: 40px;
  color: #f0f0ff;
}

.send-button {
  margin-left: 10px;
  background: linear-gradient(135deg, #00ffff 0%, #00ffcc 30%, #7b2fff 70%, #ff00ff 100%);
  color: #020010;
  border: none;
  font-size: 14px;
  padding: 5px 15px;
  font-weight: 900;
  border-radius: 6rpx;
  box-shadow:
    0 0 20rpx rgba(0, 255, 255, 0.6),
    0 0 40rpx rgba(123, 47, 255, 0.35),
    0 0 60rpx rgba(255, 0, 255, 0.25);
}

.send-button:active {
  box-shadow:
    0 0 40rpx rgba(0, 255, 255, 1),
    0 0 80rpx rgba(123, 47, 255, 0.7);
}

/* +号按钮（图片功能入口） */
.plus-button {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10px;
  background: rgba(0, 255, 255, 0.08);
  border: 2rpx solid rgba(0, 255, 255, 0.4);
  border-radius: 8px;
  flex-shrink: 0;
  transition: all 0.2s;
}

.plus-button.active {
  background: rgba(255, 0, 255, 0.15);
  border-color: rgba(255, 0, 255, 0.6);
  transform: rotate(45deg);
}

.plus-icon {
  font-size: 26px;
  font-weight: 300;
  color: #00ffff;
  line-height: 1;
  text-shadow: 0 0 10rpx rgba(0, 255, 255, 0.6);
}

.plus-button.active .plus-icon {
  color: #ff6bff;
  text-shadow: 0 0 10rpx rgba(255, 107, 255, 0.8);
}

/* 扩展面板（相册 / 拍摄） */
.extra-panel {
  display: flex;
  padding: 30rpx 20rpx;
  border-top: 2rpx solid rgba(0, 255, 255, 0.15);
  margin-top: 10rpx;
  background: rgba(0, 0, 20, 0.6);
  border-radius: 8px;
  animation: extraSlideIn 0.2s ease-out;
}

@keyframes extraSlideIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.extra-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  margin: 0 10rpx;
  background: rgba(0, 255, 255, 0.05);
  border: 2rpx solid rgba(0, 255, 255, 0.25);
  border-radius: 8px;
  transition: all 0.2s;
}

.extra-item:active {
  background: rgba(0, 255, 255, 0.15);
  border-color: rgba(0, 255, 255, 0.6);
  transform: scale(0.96);
}

.extra-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.extra-label {
  font-size: 13px;
  color: #f0f0ff;
  letter-spacing: 2rpx;
}

/* 图片气泡特殊样式（与文字气泡区分） */
.message-content.image-content {
  padding: 6px;
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
}

.message-image {
  max-width: 200px;
  border-radius: 5px;
  display: block;
}
