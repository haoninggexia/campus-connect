<!--pages/chat-room/chat-room.wxml-->
<view class="chat-container">
  <!-- 顶部标题栏 -->
  <view class="chat-header">
    <view class="back-btn">
      <image src="/image/back.png" mode="aspectFit" style="width: 32rpx; height: 32rpx;"></image>
    </view>
    <view class="title">{{otherUser.nickName || '聊天室'}}</view>
    <view class="more-btn">
      <image src="/image/more.png" mode="aspectFit" style="width: 32rpx; height: 32rpx;"></image>
    </view>
    <view class="font-size-btn" bindtap="onFontSizeSettings">
      <text class="settings-text">A</text>
    </view>
  </view>

  <!-- 消息区域 -->
  <view class="chat-messages" wx:if="{{messagesLoaded || messages.length > 0}}" style="--chat-font-size: {{fontSize}}rpx">
    <block wx:for="{{messages}}" wx:key="timestamp" wx:for-item="msg" wx:for-index="index">
      <view class="message-item {{msg.from.userID === userInfo.userID ? 'self' : 'other'}}">
        <image class="avatar clickable" wx:if="{{msg.from.userID !== userInfo.userID}}"
               src="{{cachedTempAvatars[msg.from.userID] || msg.from.customAvatar || msg.from.avatarUrl || otherUser.avatarUrl}}"
               mode="aspectFill"
               binderror="onAvatarError"
               bindtap="onViewProfile"
               data-user="{{msg.from}}"></image>
        <view class="message-bubble" style="font-size: {{fontSize}}rpx">
          {{msg.content}}
        </view>
        <image class="avatar clickable" wx:if="{{msg.from.userID === userInfo.userID}}"
               src="{{cachedTempAvatars[userInfo.userID] || userInfo.customAvatar || userInfo.avatarUrl || 'https://thirdwx.qlogo.cn/mmopen/vi_32/POgEwh4mIHO4nibH0KlMECNjjGxQUq24ZEaGT4poC6icRiccVGKSyXwibcPq4BWmiaIGuG1icwxaQX6grC9VemZoJ8rg/132'}}"
               mode="aspectFill"
               binderror="onAvatarError"
               bindtap="onViewProfile"
               data-user="{{userInfo}}"></image>
      </view>
    </block>
  </view>

  <!-- 调试信息 -->
  <view class="debug-info" wx:if="{{false}}">
    <text>用户ID: {{userInfo.userID}}</text>
    <text>头像缓存: {{cachedTempAvatars}}</text>
    <text>自己头像: {{cachedTempAvatars[userInfo.userID] || userInfo.avatarUrl}}</text>
  </view>

  <!-- 空状态提示 -->
  <view class="chat-info" wx:if="{{!messagesLoaded && messages.length === 0}}">
    加载消息中...
  </view>

  <!-- 输入区域 -->
  <view class="chat-input-area">
    <view class="input-content" bindfocus="onInputFocus" bindblur="onInputBlur">
      <input 
        class="message-input" 
        placeholder="输入消息..." 
        value="{{inputContent}}"
        bindinput="onInputChange"
        bindconfirm="onSend"
      />
    </view>
    <button class="send-btn" bindtap="onSend">
      发送
    </button>
  </view>
</view>

<!-- 用户资料弹窗 -->
<view class="profile-modal" wx:if="{{showProfileModal}}">
  <view class="profile-mask" bindtap="onCloseProfileModal"></view>
  <view class="profile-content">
    <view class="profile-header">
      <image class="profile-avatar" src="{{profileUser.customAvatar || profileUser.avatarUrl}}" mode="aspectFill" binderror="onAvatarError"></image>
      <text class="profile-name">{{profileUser.nickName}}</text>
    </view>

    <view class="profile-info">
      <view class="info-item" wx:if="{{profileUser.university}}">
        <text class="info-label">大学：</text>
        <text class="info-value">{{profileUser.university}}</text>
      </view>
      <view class="info-item" wx:if="{{profileUser.major}}">
        <text class="info-label">专业：</text>
        <text class="info-value">{{profileUser.major}}</text>
      </view>
      <view class="info-item" wx:if="{{profileUser.bio}}">
        <text class="info-label">简介：</text>
        <text class="info-value bio-text">{{profileUser.bio}}</text>
      </view>
    </view>

    <!-- 精选照片 -->
    <view class="photos-section" wx:if="{{profilePhotos.length > 0}}">
      <view class="photos-title">精选照片（{{profilePhotos.length}}张）</view>
      <view class="photos-grid">
        <view class="photo-item" wx:for="{{profilePhotos}}" wx:key="index">
          <image
            class="photo-image"
            src="{{item}}"
            mode="aspectFill"
            bindtap="onPreviewPhoto"
            data-url="{{item}}"
          ></image>
        </view>
      </view>
    </view>

    <view class="profile-footer">
      <button wx:if="{{!profileUser.isSelf}}" class="add-friend-btn" bindtap="onAddFriend">添加好友</button>
      <button class="close-btn" bindtap="onCloseProfileModal">关闭</button>
    </view>
  </view>
</view>
