/* pages/chat-room/chat-room.wxss */
.chat-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 顶部标题栏 - 微信风格 */
.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 30rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #e5e5e5;
  position: relative;
}

.chat-header .back-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chat-header .title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  color: #000;
  font-weight: 500;
}

.chat-header .more-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chat-header .font-size-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 10rpx;
}

.chat-header .settings-text {
  font-size: 28rpx;
  color: #000;
  font-weight: bold;
}

/* 消息区域 - 微信风格，完全填充可用空间 */
.chat-messages {
  flex: 1;
  padding: 20rpx 30rpx;
  overflow-y: auto;
  background-color: #f5f5f5;
  position: relative;
  min-height: 0; /* 确保flex:1能正常工作 */
}

/* 确保消息容器能正确显示滚动条 */
.chat-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 消息项目间距优化 */
.message-item {
  margin-bottom: 16rpx;
}

/* 调整消息气泡最大宽度 */
.message-bubble {
  max-width: 65%;
}

/* 消息气泡内边距优化 */
.message-bubble {
  padding: 10rpx 14rpx;
}

/* 消息气泡圆角优化 */
.message-bubble {
  border-radius: 6rpx;
}

/* 头像大小优化 */
.avatar {
  width: 40rpx;
  height: 40rpx;
}

/* 消息气泡字体大小优化 - 使用动态字体大小 */
.message-bubble {
  font-size: var(--chat-font-size, 36rpx);
}

/* 消息项目 - 微信风格 */
.message-item {
  display: flex;
  margin-bottom: 20rpx;
  position: relative;
}

/* 对方的消息 - 微信风格，头像在左 */
.message-item.other {
  justify-content: flex-start;
}

.message-item.other .avatar {
  margin-right: 12rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
}

/* 可点击的头像 */
.avatar.clickable {
  cursor: pointer;
  opacity: 0.9;
  transition: opacity 0.2s;
}

.avatar.clickable:active {
  opacity: 1;
}

.message-item.other .message-bubble {
  background-color: #ffffff;
  color: #000000;
  border-radius: 8rpx;
  max-width: 70%;
  padding: 12rpx 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-wrap: break-word;
  word-break: break-all;
  position: relative;
  box-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
}

.message-item.other .message-bubble:after {
  content: '';
  position: absolute;
  top: 14rpx;
  left: -8rpx;
  border-width: 8rpx 8rpx 8rpx 0;
  border-style: solid;
  border-color: transparent #ffffff transparent transparent;
}

/* 自己的消息 - 微信风格，头像在右 */
.message-item.self {
  justify-content: flex-end;
}

.message-item.self .avatar {
  margin-left: 12rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
}

.message-item.self .message-bubble {
  background-color: #dcf8c6;
  color: #000000;
  border-radius: 8rpx;
  max-width: 70%;
  padding: 12rpx 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-wrap: break-word;
  word-break: break-all;
  position: relative;
  box-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
}

.message-item.self .message-bubble:after {
  content: '';
  position: absolute;
  top: 14rpx;
  right: -8rpx;
  border-width: 8rpx 0 8rpx 8rpx;
  border-style: solid;
  border-color: transparent transparent transparent #dcf8c6;
}

/* 输入区域 - 微信风格 */
.chat-input-area {
  display: flex;
  align-items: center;
  padding: 16rpx 30rpx;
  background-color: #fff;
  border-top: 1rpx solid #e5e5e5;
  position: relative;
}

.input-content {
  flex: 1;
  background-color: #f5f5f5;
  border-radius: 20rpx;
  padding: 12rpx 20rpx;
  margin-right: 16rpx;
  font-size: 28rpx;
  max-height: 120rpx;
  overflow-y: auto;
}

.send-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
}

/* 聊天信息提示 */
.chat-info {
  text-align: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 用户资料弹窗 - 微信风格 */
.user-profile {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.profile-content {
  width: 85%;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.profile-header {
  padding: 30rpx;
  text-align: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.profile-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-bottom: 16rpx;
}

.profile-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.profile-id {
  font-size: 24rpx;
  opacity: 0.8;
}

.profile-body {
  padding: 30rpx;
}

.info-row {
  display: flex;
  margin-bottom: 20rpx;
  align-items: center;
}

.info-label {
  width: 100rpx;
  color: #666;
  font-size: 28rpx;
}

.info-value {
  flex: 1;
  color: #333;
  font-size: 28rpx;
}

.profile-actions {
  padding: 30rpx;
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  padding: 16rpx 0;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: 1rpx solid #ddd;
  color: #666;
}

.action-btn.primary {
  background-color: #667eea;
  color: #fff;
  border: none;
}

/* 生产环境移除调试边框 */

/* 用户资料模态框 */
.profile-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.6);
}

.profile-content {
  position: relative;
  width: 85%;
  max-width: 600rpx;
  max-height: 80vh;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.profile-header {
  padding: 40rpx 30rpx;
  text-align: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.profile-header .profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  margin-bottom: 16rpx;
}

.profile-header .profile-name {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
}

.profile-info {
  padding: 30rpx;
  max-height: 40vh;
  overflow-y: auto;
}

.info-item {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.info-label {
  width: 100rpx;
  color: #666;
  font-size: 28rpx;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  color: #333;
  font-size: 28rpx;
  word-wrap: break-word;
}

.info-value.bio-text {
  line-height: 1.6;
}

/* 精选照片 */
.photos-section {
  padding: 0 30rpx 30rpx;
  max-height: 30vh;
  overflow-y: auto;
}

.photos-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.photos-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.photo-item {
  aspect-ratio: 1;
  border-radius: 8rpx;
  overflow: hidden;
  background-color: #f5f5f5;
}

.photo-image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
  transition: opacity 0.2s;
}

.photo-image:active {
  opacity: 0.8;
}

/* 模态框底部按钮 */
.profile-footer {
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #e5e5e5;
  display: flex;
  gap: 16rpx;
}

.close-btn, .add-friend-btn {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: none;
}

.close-btn {
  background-color: #f5f5f5;
  color: #333;
}

.add-friend-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

