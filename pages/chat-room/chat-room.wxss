/* pages/chat-room/chat-room.wxss - Cyberpunk MAX */
.chat-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: linear-gradient(180deg, #020010 0%, #0a0020 100%);
}

/* 顶部标题栏 */
.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 30rpx;
  background: linear-gradient(180deg, rgba(10, 10, 35, 0.98) 0%, rgba(10, 10, 30, 0.95) 100%);
  border-bottom: 2rpx solid rgba(0, 255, 255, 0.2);
  position: relative;
  backdrop-filter: blur(30rpx);
  box-shadow:
    0 4rpx 30rpx rgba(0, 255, 255, 0.15),
    0 0 60rpx rgba(255, 0, 255, 0.08);
}

.chat-header .back-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ff6bff;
  text-shadow: 0 0 15rpx rgba(255, 107, 255, 0.6);
}

.chat-header .title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  color: #f0f0ff;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-shadow: 0 0 15rpx rgba(0, 255, 255, 0.4);
}

.chat-header .more-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #00ffff;
  text-shadow: 0 0 15rpx rgba(0, 255, 255, 0.6);
}

.chat-header .font-size-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 10rpx;
  color: #ffea00;
  text-shadow: 0 0 15rpx rgba(255, 234, 0, 0.6);
}

.chat-header .settings-text {
  font-size: 28rpx;
  color: #f0f0ff;
  font-weight: bold;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.distance-display {
  font-size: 24rpx;
  color: #ffea00;
  background-color: rgba(255, 234, 0, 0.1);
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
  white-space: nowrap;
  border: 2rpx solid rgba(255, 234, 0, 0.3);
  text-shadow: 0 0 10rpx rgba(255, 234, 0, 0.4);
}

/* 消息区域 */
.chat-messages {
  flex: 1;
  padding: 20rpx 30rpx;
  overflow-y: auto;
  background: radial-gradient(ellipse at 50% 50%, rgba(0, 255, 255, 0.02) 0%, transparent 70%);
  position: relative;
  min-height: 0;
}

.chat-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.message-item {
  margin-bottom: 16rpx;
}

.message-bubble {
  max-width: 65%;
  padding: 10rpx 14rpx;
  border-radius: 6rpx;
  font-size: var(--chat-font-size, 36rpx);
}

.avatar {
  width: 40rpx;
  height: 40rpx;
}

.message-item {
  display: flex;
  margin-bottom: 20rpx;
  position: relative;
}

/* 对方的消息 */
.message-item.other {
  justify-content: flex-start;
}

.message-item.other .avatar {
  margin-right: 12rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background-color: rgba(20, 20, 50, 0.7);
  border: 2rpx solid rgba(255, 0, 255, 0.5);
  box-shadow:
    0 0 15rpx rgba(255, 0, 255, 0.3),
    0 0 30rpx rgba(255, 0, 255, 0.15);
}

.avatar.clickable {
  cursor: pointer;
  opacity: 0.9;
  transition: opacity 0.2s;
}

.avatar.clickable:active {
  opacity: 1;
  box-shadow:
    0 0 30rpx rgba(0, 255, 255, 0.7),
    0 0 60rpx rgba(255, 0, 255, 0.4);
}

.message-item.other .message-bubble {
  background: rgba(20, 20, 50, 0.85);
  color: #f0f0ff;
  border-radius: 8rpx;
  max-width: 70%;
  padding: 12rpx 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-wrap: break-word;
  word-break: break-all;
  position: relative;
  border: 2rpx solid rgba(255, 0, 255, 0.3);
  box-shadow:
    0 2rpx 15rpx rgba(255, 0, 255, 0.2),
    0 0 30rpx rgba(255, 0, 255, 0.08);
}

.message-item.other .message-bubble:after {
  content: '';
  position: absolute;
  top: 14rpx;
  left: -8rpx;
  border-width: 8rpx 8rpx 8rpx 0;
  border-style: solid;
  border-color: transparent rgba(20, 20, 50, 0.85) transparent transparent;
}

/* 自己的消息 */
.message-item.self {
  justify-content: flex-end;
}

.message-item.self .avatar {
  margin-left: 12rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background-color: rgba(20, 20, 50, 0.7);
  border: 2rpx solid rgba(0, 255, 255, 0.5);
  box-shadow:
    0 0 15rpx rgba(0, 255, 255, 0.3),
    0 0 30rpx rgba(0, 255, 255, 0.15);
}

.message-item.self .message-bubble {
  background: linear-gradient(135deg, rgba(0, 255, 255, 0.3) 0%, rgba(0, 200, 255, 0.2) 50%, rgba(123, 47, 255, 0.35) 100%);
  color: #f0f0ff;
  border-radius: 8rpx;
  max-width: 70%;
  padding: 12rpx 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-wrap: break-word;
  word-break: break-all;
  position: relative;
  border: 2rpx solid rgba(0, 255, 255, 0.5);
  box-shadow:
    0 2rpx 20rpx rgba(0, 255, 255, 0.35),
    0 0 40rpx rgba(0, 255, 255, 0.15);
}

.message-item.self .message-bubble:after {
  content: '';
  position: absolute;
  top: 14rpx;
  right: -8rpx;
  border-width: 8rpx 0 8rpx 8rpx;
  border-style: solid;
  border-color: transparent transparent transparent rgba(0, 255, 255, 0.3);
}

/* 输入区域 */
.chat-input-area {
  display: flex;
  align-items: center;
  padding: 16rpx 30rpx;
  background: linear-gradient(180deg, rgba(10, 10, 35, 0.98) 0%, rgba(10, 10, 30, 0.95) 100%);
  border-top: 2rpx solid rgba(0, 255, 255, 0.2);
  position: relative;
  backdrop-filter: blur(30rpx);
  box-shadow: 0 -4rpx 30rpx rgba(0, 255, 255, 0.1);
}

.input-content {
  flex: 1;
  background-color: rgba(0, 0, 20, 0.9);
  border: 2rpx solid rgba(0, 255, 255, 0.3);
  border-radius: 24rpx;
  padding: 12rpx 20rpx;
  margin-right: 16rpx;
  font-size: 28rpx;
  max-height: 120rpx;
  overflow-y: auto;
  color: #f0f0ff;
  box-shadow: inset 0 0 15rpx rgba(0, 255, 255, 0.08);
}

.send-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #00ffff 0%, #00ffcc 30%, #7b2fff 70%, #ff00ff 100%);
  color: #020010;
  border: none;
  font-size: 28rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  box-shadow:
    0 0 30rpx rgba(0, 255, 255, 0.7),
    0 0 60rpx rgba(123, 47, 255, 0.4),
    0 0 90rpx rgba(255, 0, 255, 0.3);
}

.send-btn:active {
  box-shadow:
    0 0 50rpx rgba(0, 255, 255, 1),
    0 0 100rpx rgba(123, 47, 255, 0.7);
}

.chat-info {
  text-align: center;
  padding: 30rpx 0;
  color: #7a80b0;
  font-size: 28rpx;
}

.waiting-banner {
  text-align: center;
  padding: 20rpx 30rpx;
  background: linear-gradient(90deg, rgba(255, 234, 0, 0.15), rgba(255, 234, 0, 0.05), rgba(255, 234, 0, 0.15));
  border-bottom: 2rpx solid rgba(255, 234, 0, 0.4);
  backdrop-filter: blur(15rpx);
}

.waiting-text {
  font-size: 26rpx;
  color: #ffea00;
  text-shadow: 0 0 15rpx rgba(255, 234, 0, 0.5);
}

/* 用户资料弹窗 */
.user-profile {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 10, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  backdrop-filter: blur(15rpx);
}

.profile-content {
  width: 85%;
  background: rgba(10, 10, 30, 0.98);
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  border: 2rpx solid rgba(0, 255, 255, 0.35);
  box-shadow:
    0 0 50rpx rgba(0, 255, 255, 0.35),
    0 0 100rpx rgba(123, 47, 255, 0.25),
    0 0 150rpx rgba(255, 0, 255, 0.2);
}

.profile-header {
  padding: 40rpx 30rpx;
  text-align: center;
  background: linear-gradient(135deg, rgba(0, 255, 255, 0.25) 0%, rgba(123, 47, 255, 0.35) 50%, rgba(255, 0, 255, 0.25) 100%);
  border-bottom: 2rpx solid rgba(0, 255, 255, 0.2);
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 3rpx solid #00ffff;
  box-shadow:
    0 0 30rpx rgba(0, 255, 255, 0.7),
    0 0 60rpx rgba(0, 255, 255, 0.3),
    0 0 90rpx rgba(255, 0, 255, 0.25);
  margin-bottom: 16rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  color: #f0f0ff;
  text-shadow: 0 0 15rpx rgba(0, 255, 255, 0.4);
}

.profile-id {
  font-size: 24rpx;
  color: #00ffcc;
}

.profile-info {
  padding: 30rpx;
  max-height: 40vh;
  overflow-y: auto;
}

.info-item {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.info-label {
  width: 100rpx;
  color: #00ffcc;
  font-size: 28rpx;
  flex-shrink: 0;
  text-shadow: 0 0 10rpx rgba(0, 255, 204, 0.3);
}

.info-value {
  flex: 1;
  color: #f0f0ff;
  font-size: 28rpx;
  word-wrap: break-word;
}

.info-value.bio-text {
  line-height: 1.6;
}

.profile-actions {
  padding: 30rpx;
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  padding: 16rpx 0;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: 2rpx solid rgba(0, 255, 255, 0.35);
  color: #aaa0d0;
  background: transparent;
}

.action-btn.primary {
  background: linear-gradient(135deg, #00ffff 0%, #7b2fff 50%, #ff00ff 100%);
  color: #020010;
  border: none;
  font-weight: 900;
  box-shadow:
    0 0 25rpx rgba(0, 255, 255, 0.5),
    0 0 50rpx rgba(123, 47, 255, 0.4);
}

/* 照片区域 */
.photos-section {
  padding: 0 30rpx 30rpx;
  max-height: 30vh;
  overflow-y: auto;
}

.photos-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #ff6bff;
  margin-bottom: 16rpx;
  text-shadow: 0 0 12rpx rgba(255, 107, 255, 0.4);
}

.photos-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.photo-item {
  aspect-ratio: 1;
  border-radius: 8rpx;
  overflow: hidden;
  background-color: rgba(20, 20, 50, 0.7);
  border: 2rpx solid rgba(0, 255, 255, 0.25);
  box-shadow: 0 0 15rpx rgba(0, 255, 255, 0.1);
}

.photo-image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
  transition: opacity 0.2s;
}

.photo-image:active {
  opacity: 0.7;
}

.profile-footer {
  padding: 20rpx 30rpx;
  border-top: 2rpx solid rgba(0, 255, 255, 0.2);
  display: flex;
  gap: 16rpx;
}

.close-btn {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: 2rpx solid rgba(255, 0, 255, 0.35);
  background-color: transparent;
  color: #ff6bff;
  text-shadow: 0 0 10rpx rgba(255, 107, 255, 0.3);
}

/* 用户资料弹窗复用结构 */
.user-profile .profile-content {
  width: 85%;
  background: rgba(10, 10, 30, 0.98);
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  border: 2rpx solid rgba(0, 255, 255, 0.35);
  box-shadow: 0 0 50rpx rgba(0, 255, 255, 0.35), 0 0 100rpx rgba(123, 47, 255, 0.25), 0 0 150rpx rgba(255, 0, 255, 0.2);
}

.user-profile .profile-header {
  padding: 40rpx 30rpx;
  text-align: center;
  background: linear-gradient(135deg, rgba(0, 255, 255, 0.25) 0%, rgba(123, 47, 255, 0.35) 50%, rgba(255, 0, 255, 0.25) 100%);
  border-bottom: 2rpx solid rgba(0, 255, 255, 0.2);
  color: #f0f0ff;
}

.user-profile .profile-header .profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 3rpx solid #00ffff;
  box-shadow: 0 0 30rpx rgba(0, 255, 255, 0.7), 0 0 60rpx rgba(0, 255, 255, 0.3);
  margin-bottom: 16rpx;
}

.user-profile .profile-header .profile-name {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  color: #f0f0ff;
}

.user-profile .profile-info {
  padding: 30rpx;
  max-height: 40vh;
  overflow-y: auto;
}

.user-profile .info-item {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.user-profile .info-label {
  width: 100rpx;
  color: #00ffcc;
  font-size: 28rpx;
  flex-shrink: 0;
}

.user-profile .info-value {
  flex: 1;
  color: #f0f0ff;
  font-size: 28rpx;
  word-wrap: break-word;
}

/* 弹窗动画 */
.profile-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 10, 0.9);
  backdrop-filter: blur(15rpx);
}

.profile-modal .profile-content {
  position: relative;
  width: 85%;
  max-width: 600rpx;
  max-height: 80vh;
  background: rgba(10, 10, 30, 0.98);
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s ease-out;
  border: 2rpx solid rgba(0, 255, 255, 0.35);
  box-shadow: 0 0 50rpx rgba(0, 255, 255, 0.35), 0 0 100rpx rgba(123, 47, 255, 0.25);
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.profile-modal .profile-header {
  padding: 40rpx 30rpx;
  text-align: center;
  background: linear-gradient(135deg, rgba(0, 255, 255, 0.25) 0%, rgba(123, 47, 255, 0.35) 50%, rgba(255, 0, 255, 0.25) 100%);
  border-bottom: 2rpx solid rgba(0, 255, 255, 0.2);
}

.profile-modal .profile-header .profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 3rpx solid #00ffff;
  box-shadow: 0 0 30rpx rgba(0, 255, 255, 0.7), 0 0 60rpx rgba(0, 255, 255, 0.3);
  margin-bottom: 16rpx;
}

.profile-modal .profile-header .profile-name {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  color: #f0f0ff;
}

.profile-modal .profile-footer {
  padding: 20rpx 30rpx;
  border-top: 2rpx solid rgba(0, 255, 255, 0.2);
  display: flex;
  gap: 16rpx;
}

.profile-modal .close-btn {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: 2rpx solid rgba(255, 0, 255, 0.35);
  background-color: transparent;
  color: #ff6bff;
}

/* ============ 图片发送功能 ============ */

/* +号按钮（图片入口） */
.plus-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 12rpx;
  background: rgba(0, 255, 255, 0.1);
  border: 2rpx solid rgba(0, 255, 255, 0.4);
  box-shadow: 0 0 15rpx rgba(0, 255, 255, 0.25);
}

.plus-btn:active {
  background: rgba(0, 255, 255, 0.28);
  box-shadow: 0 0 25rpx rgba(0, 255, 255, 0.5);
}

.plus-icon {
  font-size: 46rpx;
  line-height: 1;
  font-weight: 300;
  color: #00ffff;
  text-shadow: 0 0 10rpx rgba(0, 255, 255, 0.6);
}

/* 图片消息气泡：去掉文字气泡的内边距与背景，让图片完整展示 */
.message-item .message-bubble.image-bubble {
  padding: 0;
  background: transparent;
  border: none;
  box-shadow: none;
  max-width: 70%;
}

.message-item .message-bubble.image-bubble:after {
  display: none;
}

.message-image {
  max-width: 420rpx;
  border-radius: 8rpx;
  display: block;
}

/* ============ 语音消息功能 ============ */

/* 语音/键盘模式切换按钮（输入框左侧，+号右边） */
.mode-switch-btn {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  margin-right: 12rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(123, 47, 255, 0.1);
  border: 2rpx solid rgba(123, 47, 255, 0.45);
  box-shadow: 0 0 15rpx rgba(123, 47, 255, 0.2);
  transition: all 0.2s;
}

.mode-switch-btn:active {
  background: rgba(123, 47, 255, 0.28);
  box-shadow: 0 0 25rpx rgba(123, 47, 255, 0.5);
}

.mode-switch-icon {
  font-size: 32rpx;
  line-height: 1;
  color: #c89bff;
  text-shadow: 0 0 10rpx rgba(123, 47, 255, 0.5);
}

/* 语音模式容器：充满输入框剩余空间 */
.voice-input-area {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

/* 按住说话 按钮 */
.press-to-talk {
  flex: 1;
  width: 100%;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 20, 0.9);
  border: 2rpx solid rgba(0, 255, 255, 0.3);
  border-radius: 8px;
  color: #f0f0ff;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  user-select: none;
  box-shadow: inset 0 0 15rpx rgba(0, 255, 255, 0.06);
}

.press-to-talk.recording {
  background: rgba(255, 107, 107, 0.22);
  border-color: rgba(255, 107, 107, 0.65);
  color: #ff8e8e;
  box-shadow:
    inset 0 0 15rpx rgba(255, 107, 107, 0.2),
    0 0 18rpx rgba(255, 107, 107, 0.35);
}

.press-to-talk.will-cancel {
  background: rgba(255, 234, 0, 0.22);
  border-color: rgba(255, 234, 0, 0.65);
  color: #ffea00;
}

/* 录音提示遮罩 */
.recording-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 10, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  backdrop-filter: blur(8rpx);
}

.recording-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx 70rpx;
  background: rgba(10, 10, 30, 0.95);
  border: 2rpx solid rgba(0, 255, 255, 0.4);
  border-radius: 20rpx;
  box-shadow:
    0 0 60rpx rgba(0, 255, 255, 0.35),
    0 0 120rpx rgba(255, 0, 255, 0.18);
}

.recording-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(255, 107, 107, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 30rpx;
  animation: recordingPulse 1.2s infinite ease-in-out;
}

@keyframes recordingPulse {
  0%   { box-shadow: 0 0 0 0   rgba(255, 107, 107, 0.55); }
  70%  { box-shadow: 0 0 0 40rpx rgba(255, 107, 107, 0); }
  100% { box-shadow: 0 0 0 0   rgba(255, 107, 107, 0); }
}

.mic-body {
  width: 22px;
  height: 38px;
  background: #ff6b6b;
  border-radius: 11px;
}

.mic-stand {
  position: absolute;
  bottom: 30rpx;
  width: 46px;
  height: 16px;
  border: 4rpx solid #ff6b6b;
  border-top: none;
  border-radius: 0 0 23px 23px;
}

.recording-time {
  font-size: 64rpx;
  font-weight: 600;
  color: #ffea00;
  text-shadow: 0 0 20rpx rgba(255, 234, 0, 0.55);
  margin-bottom: 18rpx;
  letter-spacing: 2rpx;
}

.recording-hint {
  font-size: 26rpx;
  color: #f0f0ff;
  letter-spacing: 2rpx;
}

/* 语音消息气泡容器 */
.message-item .message-bubble.voice-bubble {
  min-width: 200rpx;
  padding: 18rpx 24rpx;
}

.voice-content {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 44rpx;
}

.voice-icon {
  font-size: 32rpx;
  color: #00ffff;
  text-shadow: 0 0 10rpx rgba(0, 255, 255, 0.45);
  line-height: 1;
  flex-shrink: 0;
}

.voice-icon.playing {
  color: #ffea00;
  text-shadow: 0 0 12rpx rgba(255, 234, 0, 0.7);
  animation: voicePlayingAnim 0.6s infinite ease-in-out;
}

@keyframes voicePlayingAnim {
  0%, 100% { transform: scale(1); }
  50%      { transform: scale(1.18); }
}

.voice-waveform {
  display: flex;
  align-items: center;
  gap: 4rpx;
  height: 28rpx;
  flex: 1;
  min-width: 60rpx;
  max-width: 240rpx;
}

.voice-bar {
  width: 4rpx;
  background: linear-gradient(180deg, #00ffff, #7b2fff);
  border-radius: 2rpx;
}

.voice-bar:nth-child(1) { height: 12rpx; }
.voice-bar:nth-child(2) { height: 22rpx; }
.voice-bar:nth-child(3) { height: 16rpx; }
.voice-bar:nth-child(4) { height: 26rpx; }
.voice-bar:nth-child(5) { height: 14rpx; }

/* 语音气泡：自己一侧颜色微调（更亮） */
.message-item.self .message-bubble.voice-bubble .voice-icon {
  color: #00ffff;
}
.message-item.other .message-bubble .voice-content {
  /* 对方气泡内文字颜色 */
  color: #f0f0ff;
}

.voice-duration {
  font-size: 26rpx;
  color: #f0f0ff;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}
