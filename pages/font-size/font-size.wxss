/* pages/font-size/font-size.wxss */
.font-size-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #000;
}

/* 标题栏 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #000;
  color: #fff;
  position: relative;
  z-index: 10;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header .title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: 500;
}

.complete-btn {
  width: 100rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #07c160;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
  margin-left: 20rpx;
}

/* 预览区域 */
.preview-area {
  flex: 1;
  padding: 30rpx;
  overflow-y: auto;
}

.preview-messages {
  margin-bottom: 40rpx;
}

.preview-message {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.preview-message.other {
  justify-content: flex-start;
}

.preview-message.self {
  justify-content: flex-end;
}

.preview-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  margin-left: 12rpx;
}

.preview-message.self .preview-avatar {
  margin-left: 12rpx;
  margin-right: 0;
}

.preview-bubble {
  max-width: 70%;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  font-size: var(--preview-font-size);
  line-height: 1.5;
  word-wrap: break-word;
  word-break: break-all;
}

.preview-message.other .preview-bubble {
  background-color: #333333;
  color: #ffffff;
  position: relative;
}

.preview-message.other .preview-bubble::after {
  content: '';
  position: absolute;
  top: 16rpx;
  left: -8rpx;
  border-width: 8rpx 8rpx 8rpx 0;
  border-style: solid;
  border-color: transparent #333333 transparent transparent;
}

.preview-message.self .preview-bubble {
  background-color: #07c160;
  color: #ffffff;
  position: relative;
}

.preview-message.self .preview-bubble::after {
  content: '';
  position: absolute;
  top: 16rpx;
  right: -8rpx;
  border-width: 8rpx 0 8rpx 8rpx;
  border-style: solid;
  border-color: transparent transparent transparent #07c160;
}

/* 滑块区域 */
.slider-area {
  padding: 0 30rpx 60rpx;
}

.slider-labels {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
  color: #888888;
  font-size: 24rpx;
}

.slider-container {
  position: relative;
  height: 60rpx;
  margin-bottom: 30rpx;
}

slider {
  width: 100%;
  height: 4rpx;
  z-index: 2; /* 确保滑块在上层 */
  position: relative;
}

/* 档位指示器 */
.level-indicators {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  z-index: 1; /* 指示器在下层，不阻挡滑块交互 */
  pointer-events: none; /* 禁用指示器的鼠标事件 */
}

.indicator {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 2rpx solid;
  transform: translateX(-50%);
  z-index: 1;
}

/* 当前档位显示 */
.current-level {
  text-align: center;
  padding: 20rpx 0;
  color: #888888;
  font-size: 28rpx;
}

.current-level .level-text {
  margin-right: 10rpx;
}

.current-level .level-name {
  color: #07c160;
  font-weight: 500;
}

.current-level .level-size {
  color: #666666;
  margin-left: 5rpx;
}

/* 调试信息 */
.debug-info {
  text-align: center;
  padding: 20rpx 0;
  color: #888888;
  font-size: 24rpx;
  border-top: 1rpx solid #333;
  margin-top: 20rpx;
}

.debug-info .debug-title {
  display: block;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.debug-info .debug-item {
  display: block;
  margin: 5rpx 0;
}