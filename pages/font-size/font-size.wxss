/* pages/font-size/font-size.wxss - Cyberpunk MAX */
.font-size-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, #020010 0%, #050018 100%);
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: linear-gradient(180deg, rgba(10, 10, 35, 0.98) 0%, rgba(10, 10, 30, 0.95) 100%);
  border-bottom: 2rpx solid rgba(0, 255, 255, 0.2);
  position: relative;
  z-index: 10;
  backdrop-filter: blur(30rpx);
  box-shadow: 0 4rpx 30rpx rgba(0, 255, 255, 0.12);
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ff6bff;
  text-shadow: 0 0 15rpx rgba(255, 107, 255, 0.6);
}

.header .title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #f0f0ff;
  letter-spacing: 4rpx;
  text-shadow: 0 0 15rpx rgba(0, 255, 255, 0.4);
}

.complete-btn {
  width: 100rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #00ffff 0%, #7b2fff 50%, #ff00ff 100%);
  color: #020010;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 800;
  margin-left: 20rpx;
  box-shadow:
    0 0 20rpx rgba(0, 255, 255, 0.5),
    0 0 40rpx rgba(123, 47, 255, 0.35);
}

.preview-area {
  flex: 1;
  padding: 30rpx;
  overflow-y: auto;
}

.preview-messages {
  margin-bottom: 40rpx;
}

.preview-message {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.preview-message.other {
  justify-content: flex-start;
}

.preview-message.self {
  justify-content: flex-end;
}

.preview-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  margin-left: 12rpx;
  border: 2rpx solid rgba(255, 0, 255, 0.3);
  box-shadow: 0 0 10rpx rgba(255, 0, 255, 0.15);
}

.preview-message.self .preview-avatar {
  margin-left: 12rpx;
  margin-right: 0;
  border: 2rpx solid rgba(0, 255, 255, 0.3);
  box-shadow: 0 0 10rpx rgba(0, 255, 255, 0.15);
}

.preview-bubble {
  max-width: 70%;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  font-size: var(--preview-font-size);
  line-height: 1.5;
  word-wrap: break-word;
  word-break: break-all;
}

.preview-message.other .preview-bubble {
  background: rgba(20, 20, 50, 0.85);
  color: #f0f0ff;
  position: relative;
  border: 2rpx solid rgba(255, 0, 255, 0.3);
  box-shadow: 0 0 15rpx rgba(255, 0, 255, 0.1);
}

.preview-message.other .preview-bubble::after {
  content: '';
  position: absolute;
  top: 16rpx;
  left: -8rpx;
  border-width: 8rpx 8rpx 8rpx 0;
  border-style: solid;
  border-color: transparent rgba(20, 20, 50, 0.85) transparent transparent;
}

.preview-message.self .preview-bubble {
  background: linear-gradient(135deg, rgba(0, 255, 136, 0.35) 0%, rgba(0, 255, 255, 0.3) 100%);
  color: #f0f0ff;
  position: relative;
  border: 2rpx solid rgba(0, 255, 136, 0.5);
  box-shadow:
    0 0 20rpx rgba(0, 255, 136, 0.3),
    0 0 35rpx rgba(0, 255, 255, 0.15);
}

.preview-message.self .preview-bubble::after {
  content: '';
  position: absolute;
  top: 16rpx;
  right: -8rpx;
  border-width: 8rpx 0 8rpx 8rpx;
  border-style: solid;
  border-color: transparent transparent transparent rgba(0, 255, 136, 0.4);
}

/* 滑块区域 */
.slider-area {
  padding: 0 30rpx 60rpx;
}

.slider-labels {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
  color: #00ffcc;
  font-size: 24rpx;
  text-shadow: 0 0 10rpx rgba(0, 255, 204, 0.4);
}

.slider-container {
  position: relative;
  height: 60rpx;
  margin-bottom: 30rpx;
}

slider {
  width: 100%;
  height: 4rpx;
  z-index: 2;
  position: relative;
}

.level-indicators {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  z-index: 1;
  pointer-events: none;
}

.indicator {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(0, 255, 255, 0.6);
  transform: translateX(-50%);
  z-index: 1;
  box-shadow: 0 0 10rpx rgba(0, 255, 255, 0.3);
}

.current-level {
  text-align: center;
  padding: 20rpx 0;
  color: #aaa0d0;
  font-size: 28rpx;
}

.current-level .level-text {
  margin-right: 10rpx;
}

.current-level .level-name {
  color: #ffea00;
  font-weight: 600;
  text-shadow: 0 0 15rpx rgba(255, 234, 0, 0.6);
}

.current-level .level-size {
  color: #7a80b0;
  margin-left: 5rpx;
}

.debug-info {
  text-align: center;
  padding: 20rpx 0;
  color: #7a80b0;
  font-size: 24rpx;
  border-top: 2rpx solid rgba(0, 255, 255, 0.15);
  margin-top: 20rpx;
}

.debug-info .debug-title {
  display: block;
  font-weight: bold;
  margin-bottom: 10rpx;
  color: #00ffff;
  text-shadow: 0 0 10rpx rgba(0, 255, 255, 0.4);
}

.debug-info .debug-item {
  display: block;
  margin: 5rpx 0;
}
