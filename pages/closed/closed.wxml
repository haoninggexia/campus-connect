<!--pages/closed/closed.wxml-->
<view class="page">
  <view class="bg-glow"></view>

  <view class="content" wx:if="{{loaded}}">
    <view class="logo" bindlongpress="onSecretLongPress">你的回声谷</view>

    <view class="status-badge">
      <view class="dot"></view>
      <text>未开放</text>
    </view>

    <view class="message">{{message}}</view>

    <view class="schedule" wx:if="{{scheduleText}}">
      <text class="schedule-key">开放时段</text>
      <text class="schedule-val">{{scheduleText}}</text>
    </view>

    <view class="email-card">
      <view class="email-title">开放提醒</view>
      <view class="email-desc">留下邮箱，开放时第一时间邮件通知你</view>
      <block wx:if="{{!emailSubscribed}}">
        <input class="email-input" type="text" value="{{email}}" placeholder="请输入邮箱地址"
          placeholder-class="email-placeholder" bindinput="onEmailInput" />
        <button class="email-btn" bindtap="onSubscribeEmail" loading="{{emailSubscribing}}" hover-class="none">
          通知我
        </button>
        <view class="email-tip" wx:if="{{emailTip}}">{{emailTip}}</view>
      </block>
      <view class="email-done" wx:else>
        <text class="email-done-icon">✓</text>
        <text>已登记，开放时会邮件通知你</text>
      </view>
    </view>

    <button class="refresh-btn" bindtap="onManualRefresh" loading="{{checking}}" hover-class="none">
      刷新状态
    </button>

  </view>

  <view class="content" wx:else>
    <view class="logo" bindlongpress="onSecretLongPress">你的回声谷</view>
    <view class="loading-text">正在检查开放状态...</view>
  </view>
</view>
