.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #020010 0%, #0a0025 50%, #020010 100%);
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

.card {
  background: rgba(10, 10, 30, 0.85);
  border-radius: 20rpx;
  padding: 40rpx 34rpx;
  border: 2rpx solid rgba(0, 255, 255, 0.25);
  box-shadow: 0 0 30rpx rgba(0, 255, 255, 0.15);
}

.title {
  font-size: 40rpx;
  font-weight: 900;
  color: #00ffff;
  text-align: center;
  margin-bottom: 50rpx;
  text-shadow: 0 0 20rpx rgba(0, 255, 255, 0.6);
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #00ffcc;
  margin-bottom: 16rpx;
}

.section-content {
  font-size: 28rpx;
  color: #c0c0e0;
  line-height: 1.8;
  text-align: justify;
}
